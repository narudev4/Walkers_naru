# 落合コーポ — マネーフォワード クラウド請求書 API 実証 — 環境変数サンプル
# このファイル(.env.example)はコミット可。実値は .env に入れる（.env は .gitignore 済み）。
#
# 取得手順（naru がブラウザで実施 / 詳細は README.md「人手ステップ」）:
#   1. マネフォ クラウドにログイン →「アプリポータル」で連携用アプリを新規作成
#      （請求書サポート: API連携（開発者向け）→「APIの利用を開始する」からアプリポータルへ）
#   2. アプリに以下を設定:
#        - リダイレクトURI(コールバックURL): 下の MF_REDIRECT_URI と完全一致させる
#        - スコープ: mfc/invoice/data.write
#        - クライアント認証方式: CLIENT_SECRET_POST（下の MF_TOKEN_AUTH_METHOD と一致）
#   3. 発行された client_id / client_secret を下に貼る

# ── アプリ登録で取得（必須）──
MF_CLIENT_ID=
MF_CLIENT_SECRET=

# ── 認可フロー設定 ──
# アプリ登録画面の「リダイレクトURI」と1文字違わず一致させること（OAuth最大のハマりどころ）
MF_REDIRECT_URI=http://localhost:8787/callback
# 請求書の作成・取得に必要なスコープ
MF_SCOPE=mfc/invoice/data.write
# トークンエンドポイントのクライアント認証方式: client_secret_post か client_secret_basic
# （アプリ登録の「クライアント認証方式」と一致させる。none=公開クライアントなら secret 不要）
MF_TOKEN_AUTH_METHOD=client_secret_post

# ── トークン ──
# 通常は `npm run auth` 実行後に .mf-tokens.json へ自動保存される。
# 手動運用（フォールバック）する場合のみ、ブラウザ等で取得した値をここに貼ると即 invoice を叩ける。
MF_ACCESS_TOKEN=
MF_REFRESH_TOKEN=

# ── エンドポイント（通常は変更不要・公式の正規値）──
MF_AUTH_BASE=https://api.biz.moneyforward.com
MF_API_BASE=https://invoice.moneyforward.com/api/v3
