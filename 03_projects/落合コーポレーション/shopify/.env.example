# 落合コーポ B2B 掛け率検証 — 環境変数サンプル
# このファイル(.env.example)はコミット可。実値は .env に入れる（.env は .gitignore 済み）。
#
# 取得手順:
#   Shopify Admin → Settings → Apps and sales channels → Develop apps
#   → Create an app → Configure Admin API scopes → Install → Reveal token once
#   必要スコープ: read/write_customers, read_products, read/write_draft_orders,
#                read/write_metaobjects, read/write_metafields

SHOPIFY_STORE_DOMAIN=xn-dfum9d9e7a6a1b3d8dc3778hkjvcsh3d.myshopify.com

# Admin API アクセストークン（shpat_ で始まる）
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin GraphQL API バージョン（実装時に最新安定版を公式で確認のうえ確定）
SHOPIFY_API_VERSION=2025-10
