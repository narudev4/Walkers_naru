# ============================================================
# YouTube AI動画ワークスペース .gitignore
# ============================================================

# --- ランタイムログ・ロック ---
logs/*.log
logs/launchd-stdout.log
logs/launchd-stderr.log
*.lock

# --- バックアップ・一時ファイル ---
*.bak
*.bak-*
*.backup
~$*.pptx
~$*.docx
~$*.xlsx

# --- macOS ---
.DS_Store

# --- プロジェクト副産物（毎回上書きされる、track 不要）---
# debug/ : アバター配置リトライ時のデバッグ SS
# heygen-setup-progress.json : レジューム用の状態ファイル
# audio/_archive/ : 音声分割で退避したファイル
# audio/whisper_segments.json : Whisper キャッシュ（再生成可）
projects/*/debug/
projects/*/heygen-setup-progress.json
projects/*/heygen-setup-progress.json.bak-*
projects/*/audio/_archive/
projects/*/audio/whisper_segments.json
